DOMAIN=ctf.example.org
DB_PASSWORD=change-me-to-a-long-random-string
# Keys the stored flag hashes. Generate once (openssl rand -hex 32) and never
# change it, or every stored flag stops matching.
FLAG_PEPPER=change-me-openssl-rand-hex-32
# Name shown in the site header
SITE_NAME=Gh057 CTF
# Encrypts 2FA secrets in the database and keys recovery-code hashes.
# Generate once (openssl rand -hex 32). Changing it breaks everyone's 2FA and recovery codes.
SECRET_KEY=change-me-openssl-rand-hex-32
# "required" (default): organisers must turn on 2FA before managing events.
# "optional": they may skip it.
ORGANISER_MFA=required
